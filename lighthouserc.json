{
  "ci": {
    "collect": {
      "staticDistDir": "./public",
      "url": [
        "http://localhost/",
        "http://localhost/agentic-spring-boot-testing-course/",
        "http://localhost/lp/agentic-readiness-bundle/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "blockedUrlPatterns": [
          "*analytics.rieckpil.de*",
          "*mailerlite.com*",
          "*mailchimp.com*",
          "*list-manage.com*",
          "*mlcdn.com*"
        ],
        "chromeFlags": "--headless=new --no-first-run --no-default-browser-check"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median-run"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.6,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-report"
    }
  }
}
