# Purchase Power Parity (PPP) pricing - copy to .env for `npm run dev:netlify`.
# Real values are set in the Netlify UI (Project configuration > Environment variables)
# and must never be committed.

# CopeCart product IDs, read by Hugo at build time (os.Getenv) for the checkout links.
PPP_PRODUCT_ID_SOLO=copecart-product-id-solo
PPP_PRODUCT_ID_TEAM=copecart-product-id-team

# Coupon codes per PPP tier, read only by the edge function netlify/edge-functions/ppp.ts.
# Tier 1 has no coupon (full price).
PPP_COUPON_TIER_2=TEST30
PPP_COUPON_TIER_3=TEST50
PPP_COUPON_TIER_4=TEST70

# Optional: allows `?country=xx&token=<value>` on production for QA. Leave empty to disable.
PPP_TEST_TOKEN=
