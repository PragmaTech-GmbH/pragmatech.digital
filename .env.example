# Purchase Power Parity (PPP) pricing - copy to .env for `npm run dev:netlify`.
# Real values are set in the Netlify UI (Project configuration > Environment variables)
# and must never be committed.

# CopeCart product IDs, read by Hugo at build time (os.Getenv) for the checkout links.
PPP_PRODUCT_ID_COURSE_EDITION=copecart-product-id-course-edition
PPP_PRODUCT_ID_BUNDLE_EDITION=copecart-product-id-bundle-edition
PPP_PRODUCT_ID_TEAM_EDITION=copecart-product-id-team-edition

# Coupon codes per PPP tier, read only by the edge function netlify/edge-functions/ppp.ts.
# Tier 1 has no coupon (full price).
PPP_COUPON_TIER_2=TEST30
PPP_COUPON_TIER_3=TEST50
PPP_COUPON_TIER_4=TEST70

# Black Friday coupons, one per PPP tier (30 % off the base price on top of PPP, multiplied:
# 30 / 51 / 65 / 79 %), valid 2026-11-27 08:00-23:59 UTC. Read only by the edge function.
# QA: append ?now=2026-11-27T12:00:00Z to /api/ppp or to the course page.
BLACK_FRIDAY_COUPON_TIER_1=TESTBF30
BLACK_FRIDAY_COUPON_TIER_2=TESTBF51
BLACK_FRIDAY_COUPON_TIER_3=TESTBF65
BLACK_FRIDAY_COUPON_TIER_4=TESTBF79

# Optional: allows `?country=xx&token=<value>` on production for QA. Leave empty to disable.
PPP_TEST_TOKEN=
